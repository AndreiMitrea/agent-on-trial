# Courtroom env. Set these in Vercel (root directory: courtroom). No private keys live here.

# Upstash Redis (Vercel Marketplace). Read by Redis.fromEnv().
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret for host-only routes and pages.
# The terminal sends it as the x-host-secret header; the host browser gets a cookie via /bench?key=<secret>.
HOST_SECRET=

# Anthropic, for /cross and the closing statements.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Celo mainnet RPC for the chain reads.
CELO_RPC_URL=https://forno.celo.org

# Public origin of this app. Used for the QR code and self links.
NEXT_PUBLIC_COURTROOM_URL=https://your-deployment.vercel.app

# Swarm gateway for bzz:// exhibits.
SWARM_GATEWAY_URL=https://api.gateway.ethswarm.org

# Optional fallback agentId for /agent/registration.json before any evidence is posted.
AGENT_ID=
